      "text": "ChatServer\n// handles establishing connection\n//handles the incoming message , and connections\n\n// ideally Connections should be handled\n// seperately as it doesnt have that much of volume \n// associated with it \n\n// handles the delegation of message\n// to other server as well \nprivate:\nChatRepository *registery ;//to find the relvant server\numap< int ,  WebSocket* > active_sockets ;\nint nodeId;\nIRemoteBroker *broker ;\npublic:\n\nChatServer () {\n    // each server will subscribe to its own topic\n    string mytopic = \"server_\" + to_string(nodeId)\n    // need to pass this way \n    // because myhandler is inside the class\n    // ans has an imaginary parameter called this\n    broker->subscribe(myTopic , [this](string paylaod ){ \n        this->handleCrossServer(payload)\n    }\n}\n\nvoid connect ( int userID ) {\n    active_sockets[userID] = new WebSocket(userID) ;\n    registery->register(userID , nodeId )\n}\n\nvoid handleIncomingMessage(Message m ) {\n    // find the recepients servernode\n    int sentToUserId = m.sentToUserId ;\n    int recipeintServerId = registery->getServerId(sentToUserId) ;\n    \n    if (nodeId == receipeintServerId ) {\n        // local delivery , recipeint on same server \n           active_sockets[sentToUserId]->pushMessage(m) ;\n    } else {\n        target_topic = \"server_\" + to_string(reciepentServerId)\n    \n    }\n}\n\nvoid handleIncomingConnection(Connection m ) {\n    // find the recepients servernode\n    int sentToUserId = m.sentToUserId ;\n    int recipeintServerId = registery->getServerId(sentToUserId) ;\n    \n    if (nodeId == receipeintServerId ) {\n        // local delivery , recipeint on same server \n           active_sockets[sentToUserId]->pushConnnection(m) ;\n    } else {\n         // similar logic as the incoming message\n      }\n}\n\nprivate:\n   void handleCrossMessage ( string&serialised){\n        size_t delim = serialized.find('|');\n        int target_user = std::stoi(serialized.substr(0, delim));\n        std::string payload = serialized.substr(delim + 1);\n\n        auto it = active_sockets.find(target_user);\n        if (it != active_sockets.end()) {\n            it->second->pushMessage(payload);\n        }\n    }\n    \n}\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ChatServer\n// handles establishing connection\n//handles the incoming message , and connections\n\n// ideally Connections should be handled\n// seperately as it doesnt have that much of volume \n// associated with it \n\n// handles the delegation of message\n// to other server as well \nprivate:\nChatRepository *registery ;//to find the relvant server\numap< int ,  WebSocket* > active_sockets ;\nint nodeId;\nIRemoteBroker *broker ;\npublic:\n\nChatServer () {\n    // each server will subscribe to its own topic\n    string mytopic = \"server_\" + to_string(nodeId)\n    // need to pass this way \n    // because myhandler is inside the class\n    // ans has an imaginary parameter called this\n    broker->subscribe(myTopic , [this](string paylaod ){ \n        this->handleCrossServer(payload)\n    }\n}\n\nvoid connect ( int userID ) {\n    active_sockets[userID] = new WebSocket(userID) ;\n    registery->register(userID , nodeId )\n}\n\nvoid handleIncomingMessage(Message m ) {\n    // find the recepients servernode\n    int sentToUserId = m.sentToUserId ;\n    int recipeintServerId = registery->getServerId(sentToUserId) ;\n    \n    if (nodeId == receipeintServerId ) {\n        // local delivery , recipeint on same server \n           active_sockets[sentToUserId]->pushMessage(m) ;\n    } else {\n        target_topic = \"server_\" + to_string(reciepentServerId)\n    \n    }\n}\n\nvoid handleIncomingConnection(Connection m ) {\n    // find the recepients servernode\n    int sentToUserId = m.sentToUserId ;\n    int recipeintServerId = registery->getServerId(sentToUserId) ;\n    \n    if (nodeId == receipeintServerId ) {\n        // local delivery , recipeint on same server \n           active_sockets[sentToUserId]->pushConnnection(m) ;\n    } else {\n         // similar logic as the incoming message\n      }\n}\n\nprivate:\n   void handleCrossMessage ( string&serialised){\n        size_t delim = serialized.find('|');\n        int target_user = std::stoi(serialized.substr(0, delim));\n        std::string payload = serialized.substr(delim + 1);\n\n        auto it = active_sockets.find(target_user);\n        if (it != active_sockets.end()) {\n            it->second->pushMessage(payload);\n        }\n    }\n    \n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
