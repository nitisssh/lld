      "boundElements": [],
      "updated": 1781513963239,
      "link": null,
      "locked": false,
      "text": "void depositeCash( int accountId,  int amount ) {\n  \n    repo->accounts[accountId].balance += amount ;\n}\nvoid withdrawCash( int accountId,  int amount ) {\n      // extra logic to see if the amount even exists or not\n    repo->accounts[accountId].balance -= amount ;\n}",
      "fontSize": 17.73458043096255,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void depositeCash( int accountId,  int amount ) {\n  \n    repo->accounts[accountId].balance += amount ;\n}\nvoid withdrawCash( int accountId,  int amount ) {\n      // extra logic to see if the amount even exists or not\n    repo->accounts[accountId].balance -= amount ;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
