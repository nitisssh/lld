      "seed": 1906866698,
      "version": 479,
      "versionNonce": 1778929546,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781519171323,
      "link": null,
      "locked": false,
      "text": "The ATM system should support basic operations such as balance inquiry,\ncash withdrawal, and cash deposit.",
      "fontSize": 24.467904074695554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ATM system should support basic operations such as balance inquiry, cash withdrawal, and cash deposit.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "GyYWGzUOWcnI1-Pg_BaDV",
      "type": "text",
      "x": 29.958594994907685,
      "y": 19.50236801312076,
      "width": 869.6376074466243,
      "height": 61.169760186738884,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 918258582,
      "version": 479,
      "versionNonce": 1426966038,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781519171323,
      "link": null,
      "locked": false,
      "text": "Users should be able to authenticate themselves using a card and a PIN\n(Personal Identification Number).",
      "fontSize": 24.467904074695554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Users should be able to authenticate themselves using a card and a PIN (Personal Identification Number).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yZfgIISrbVM218NR_s3TO",
      "type": "text",
      "x": 21.35737567688375,
      "y": 316.6100231077695,
      "width": 891.7565389676645,
      "height": 61.169760186738884,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1197517002,
      "version": 609,
      "versionNonce": 539610698,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781519171323,
      "link": null,
      "locked": false,
      "text": "The system should interact with a bank's backend system to validate user\naccounts and perform transactions.",
      "fontSize": 24.467904074695554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system should interact with a bank's backend system to validate user accounts and perform transactions.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5m_mzZyYJm6ufGpZpbfSL",
      "type": "text",
      "x": 66.09766243199113,
      "y": 181.60223250797878,
      "width": 797.3594725724582,
      "height": 30.584880093369442,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1525850326,
      "version": 479,
      "versionNonce": 718836566,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781519171323,
      "link": null,
      "locked": false,
      "text": "The ATM should have a cash dispenser to dispense cash to users.",
      "fontSize": 24.467904074695554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ATM should have a cash dispenser to dispense cash to users.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
