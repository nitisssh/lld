      "y": 224.42106463869595,
      "width": 889.3341656885899,
      "height": 30.584880093369442,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
