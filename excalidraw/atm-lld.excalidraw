      "updated": 1781513175906,
      "link": null,
      "locked": false,
      "text": "    ATM FACADE\n\nprivate:\ntrasactionService *tservice ; \nbankService *bservice;\npublic:\n\ndepositeMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->depositeCash( bservice->getAccountIdFromCardId (cardId) , amount) ;\n    }\n}\n\nWithdrawMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->withdrawCash( bservice->getAccountIdFromCardId (cardId) , amount) ;\n    }\n}\n\nInquireMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->getBalance( bservice->getAccountIdFromCardId (cardId) ) ;\n    }\n}\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    ATM FACADE\n\nprivate:\ntrasactionService *tservice ; \nbankService *bservice;\npublic:\n\ndepositeMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->depositeCash( bservice->getAccountIdFromCardId (cardId) , amount) ;\n    }\n}\n\nWithdrawMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->withdrawCash( bservice->getAccountIdFromCardId (cardId) , amount) ;\n    }\n}\n\nInquireMoney (int cardId , int amount) {\n    if ( tservice->onInsertCard(cardId , int pin )) {\n        tservice->getBalance( bservice->getAccountIdFromCardId (cardId) ) ;\n    }\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
