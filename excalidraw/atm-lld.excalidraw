      "isDeleted": true,
      "boundElements": [],
      "updated": 1781519171323,
      "link": null,
      "locked": false,
      "text": "The system should handle concurrent access and ensure data consistency.",
      "fontSize": 24.467904074695554,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system should handle concurrent access and ensure data consistency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
