      "text": "bankService\n\nprivate:\nbankRepository *repo ;\nuserRepository *urepo ;\nuserService *uservice;\nICardFactory *factory ;\npublic:\n\nICardFactory createSavingsCard(int id , int pin , int bankId , int userid) {\n  Card *card= factory->createCard(id , pin , bankId , userId) ;\n  urepo->addCardId(card->cardId)\n  repo->AddCard(card)\n}\nvoid addUserId (int id ) {\n\n    repo->userIds.insert(id) \n}\n\nvoid addAtm (Atm* atm) {\n   repo -> addAtm (atm) :\n}\n",
      "fontSize": 18.830352729587556,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bankService\n\nprivate:\nbankRepository *repo ;\nuserRepository *urepo ;\nuserService *uservice;\nICardFactory *factory ;\npublic:\n\nICardFactory createSavingsCard(int id , int pin , int bankId , int userid) {\n  Card *card= factory->createCard(id , pin , bankId , userId) ;\n  urepo->addCardId(card->cardId)\n  repo->AddCard(card)\n}\nvoid addUserId (int id ) {\n\n    repo->userIds.insert(id) \n}\n\nvoid addAtm (Atm* atm) {\n   repo -> addAtm (atm) :\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
