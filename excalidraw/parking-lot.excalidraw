      "text": "//its job is to deal with\n// with any issues \n// regarding this plot\nPlotService :\n\nprivate:\n//{ plotId , Plot object}\nunordered_map < int , *Plot> plots;\n \npublic:\n\nvoid addPlot (Plot* plot ) {\n    plots[plot->id] = plot ;\n}\n\nint bookPlot (int plotId ) {\n    bool response = plots[plotId]->book(currTime) ;\n    if ( response == false } {\n        cout << \"please try again later\" << endl ;\n    }\n   return currTime ;\n}\n\nbool checkAvaialibiltiy ( int plotId ) {\n    return plots[plotId]->isAvailable\n} \n\nint releasePlot (int plotId ) {\n    int response = plots[plotId]->release() ;\n    if ( response == false } {\n        cout << \"please try again later\" << endl ;\n    }\n    return response \n}\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//its job is to deal with\n// with any issues \n// regarding this plot\nPlotService :\n\nprivate:\n//{ plotId , Plot object}\nunordered_map < int , *Plot> plots;\n \npublic:\n\nvoid addPlot (Plot* plot ) {\n    plots[plot->id] = plot ;\n}\n\nint bookPlot (int plotId ) {\n    bool response = plots[plotId]->book(currTime) ;\n    if ( response == false } {\n        cout << \"please try again later\" << endl ;\n    }\n   return currTime ;\n}\n\nbool checkAvaialibiltiy ( int plotId ) {\n    return plots[plotId]->isAvailable\n} \n\nint releasePlot (int plotId ) {\n    int response = plots[plotId]->release() ;\n    if ( response == false } {\n        cout << \"please try again later\" << endl ;\n    }\n    return response \n}\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
