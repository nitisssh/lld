      "link": null,
      "locked": false,
      "text": "Parking LotService\n\npublic:\nint totLevel = 10;\nFloorService *f = new FloorService();\nPlotService *p = new PlotService() ;\n\n// logc to create multile plots \n// logic to create multiple floors and add to the\nrespective services \n\nUser *u = new User ( 1 , EnumType::Car ) ;\n\nvector < vector < int >> available ;\navailablee = f->findAvailable(u->t) ;\n\n// logic to pick a random level and random plot \nint booktime = p->bookPlot(chosenId) ;\nTicket *t = new Ticket ( 5323 , booktime , t ,\nchoseId);\n\nint releaseTime = p->releasePlot(t->plotId) ;\n\nint duration = abs ( releasetime - booktime ) ; \n\nIPaymentStrategy *str = new FloorWisePricing (35) ;\n\ncout << \"amountPaid \" << str->calculate(duration ,\nfloorchose , t)\n\n\n",
      "fontSize": 18.207833167526385,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parking LotService\n\npublic:\nint totLevel = 10;\nFloorService *f = new FloorService();\nPlotService *p = new PlotService() ;\n\n// logc to create multile plots \n// logic to create multiple floors and add to the respective services \n\nUser *u = new User ( 1 , EnumType::Car ) ;\n\nvector < vector < int >> available ;\navailablee = f->findAvailable(u->t) ;\n\n// logic to pick a random level and random plot \nint booktime = p->bookPlot(chosenId) ;\nTicket *t = new Ticket ( 5323 , booktime , t , choseId);\n\nint releaseTime = p->releasePlot(t->plotId) ;\n\nint duration = abs ( releasetime - booktime ) ; \n\nIPaymentStrategy *str = new FloorWisePricing (35) ;\n\ncout << \"amountPaid \" << str->calculate(duration , floorchose , t)\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
