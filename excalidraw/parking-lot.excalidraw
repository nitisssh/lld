      "isDeleted": false,
      "boundElements": [],
      "updated": 1781526507410,
      "link": null,
      "locked": false,
      "text": "Each parking spot should be able to accommodate a specific type of vehicle.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each parking spot should be able to accommodate a specific type of vehicle.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
