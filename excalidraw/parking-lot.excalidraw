      "isDeleted": false,
      "boundElements": [],
      "updated": 1781526507410,
      "link": null,
      "locked": false,
      "text": "The system should assign a parking spot to a vehicle upon entry and release\nit when the vehicle exits.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system should assign a parking spot to a vehicle upon entry and release it when the vehicle exits.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3hyU-evJICjIaj1xiB4UV",
