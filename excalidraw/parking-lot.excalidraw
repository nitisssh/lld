      "updated": 1781526507410,
      "link": null,
      "locked": false,
      "text": "The parking lot should have multiple levels, each level with a certain number of\nparking spots.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The parking lot should have multiple levels, each level with a certain number of parking spots.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "b3-poTtsGLluwJYn7dApH",
      "type": "text",
      "x": -321.31663295252906,
      "y": 319.646893892484,
      "width": 711.5196533203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2K",
      "roundness": null,
      "seed": 555121866,
      "version": 72,
      "versionNonce": 293006737,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781526507410,
      "link": null,
      "locked": false,
      "text": "The parking lot should support different types of vehicles, such as cars,\nmotorcycles, and trucks.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The parking lot should support different types of vehicles, such as cars, motorcycles, and trucks.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5appv6xxAwWN42mjajcsI",
      "type": "text",
