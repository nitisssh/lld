      "link": null,
      "locked": false,
      "text": "Plot\n\npublic:\n\nint plotId ;\nbool isAvailable;\nbool bookingTime ;\nmutex mtx ;\n\nbool book(Time t) {\n    if ( (currTime - t) > 3s) {\n        return false ;\n    }\n    lock_guard<mutex> lock(mtx) ;\n    isAvailable = false; \n    bookingTime = t ;\n}\n\nint release (Time t) {\n    if ( (currTime - t) > 3s) {\n        return false ;\n    }\n    lock_guard<mutex> lock(mtx) ;\n    isAvailable = true ; \n    return bookingTime ;\n}\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Plot\n\npublic:\n\nint plotId ;\nbool isAvailable;\nbool bookingTime ;\nmutex mtx ;\n\nbool book(Time t) {\n    if ( (currTime - t) > 3s) {\n        return false ;\n    }\n    lock_guard<mutex> lock(mtx) ;\n    isAvailable = false; \n    bookingTime = t ;\n}\n\nint release (Time t) {\n    if ( (currTime - t) > 3s) {\n        return false ;\n    }\n    lock_guard<mutex> lock(mtx) ;\n    isAvailable = true ; \n    return bookingTime ;\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
